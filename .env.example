# API Configuration Example
# This file serves as a reference for API configuration

# API Key for pronunciation-service backend
# For development: Set this in src/environments/environment.ts
# For production: Use build-time replacement or runtime configuration
# NEVER commit actual API keys to version control

# Example:
# API_KEY=your-api-key-here

# Note: Angular applications require additional configuration to load
# environment variables from .env files (e.g., using @ngx-env/builder
# or custom webpack configuration)
